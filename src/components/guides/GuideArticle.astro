---
import { type CollectionEntry, render } from "astro:content";
import { localizePath } from "@/i18n";
import Layout from "@/layouts/Layout.astro";
import {
	alternateGuidePaths,
	guidePath,
	guidesIndexPath,
	sortGuides,
} from "@/lib/guides";
import {
	ArrowRight,
	BookOpen,
	Clock3,
	FileText,
	Sparkles,
} from "@lucide/astro";

interface Props {
	guide: CollectionEntry<"guides">;
	allGuides: CollectionEntry<"guides">[];
}

const { guide, allGuides } = Astro.props;
const { Content, headings } = await render(guide);
const { data } = guide;
const lang = data.locale;
const currentPath = guidePath(lang, data.slug);
const guidesPath = guidesIndexPath(lang);
const homePath = localizePath("/", lang);
const contactPath = localizePath("/#contact", lang);
const alternatePaths = alternateGuidePaths(allGuides, data.translationKey);
const related = sortGuides(
	allGuides.filter(
		(candidate) =>
			candidate.data.locale === lang &&
			candidate.data.audience === data.audience &&
			candidate.data.id !== data.id,
	),
).slice(0, 4);
const availableAudiences = new Set(
	allGuides
		.filter((candidate) => candidate.data.locale === lang)
		.map((candidate) => candidate.data.audience),
);
const visibleHeadings = headings.filter(
	(heading) => heading.depth === 2 || heading.depth === 3,
);

const labels =
	lang === "uk"
		? {
				guides: "Посібники",
				inArticle: "У цьому матеріалі",
				updated: "Оновлено",
				manager: "Для менеджера",
				barista: "Для баристи",
				team: "Для команди",
				related: "Що читати далі",
				open: "Відкрити матеріал",
				helpTitle: "Потрібна допомога?",
				helpBody:
					"Напишіть нам — допоможемо налаштувати SORT під роботу вашого закладу.",
				helpAction: "Написати нам",
				landing: "Огляд",
				tutorial: "Навчальний посібник",
				"how-to": "Практична інструкція",
				reference: "Довідка",
				explanation: "Пояснення",
			}
		: {
				guides: "Guides",
				inArticle: "In this guide",
				updated: "Updated",
				manager: "For managers",
				barista: "For baristas",
				team: "For the team",
				related: "Read next",
				open: "Open guide",
				helpTitle: "Need a hand?",
				helpBody:
					"Write to us and we will help shape SORT around your café workflow.",
				helpAction: "Write to us",
				landing: "Overview",
				tutorial: "Tutorial",
				"how-to": "How-to guide",
				reference: "Reference",
				explanation: "Explanation",
			};
const modeLabel = data.diataxis ? labels[data.diataxis] : labels.landing;
const formattedUpdated = new Intl.DateTimeFormat(
	lang === "uk" ? "uk-UA" : "en-GB",
	{
		dateStyle: "long",
	},
).format(new Date(`${data.updated}T00:00:00Z`));
---

<Layout
	lang={lang}
	title={`${data.title} — SORT`}
	description={data.summary}
	keywords="SORT, Poster, café expiry dates, product shelf life"
	currentPath={currentPath}
	alternatePaths={alternatePaths}
>
	<section class="site-container pt-12 md:pt-20">
		<nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 text-sm text-neutral-500 dark:text-neutral-400">
			<a href={homePath} class="transition-colors hover:text-primary">SORT</a>
			<span aria-hidden="true">/</span>
			<a href={guidesPath} class="transition-colors hover:text-primary">{labels.guides}</a>
			<span aria-hidden="true">/</span>
			<span class="text-neutral-700 dark:text-neutral-200" aria-current="page">{data.title}</span>
		</nav>

		<nav aria-label={lang === "uk" ? "Посібники за аудиторією" : "Guides by audience"} class="mt-7 flex flex-wrap gap-2">
			{(["manager", "barista", "team"] as const).filter((audience) => availableAudiences.has(audience)).map((audience) => (
				<a
					href={`${guidesPath}#${audience}`}
					aria-current={audience === data.audience ? "true" : undefined}
					class:list={[
						"rounded-full border px-3 py-1.5 text-xs font-medium transition-colors",
						audience === data.audience
							? "border-primary bg-primary text-white"
							: "border-primary/15 text-neutral-500 hover:border-primary/40 hover:text-primary dark:border-neutral-700 dark:text-neutral-400",
					]}
				>
					{labels[audience]}
				</a>
			))}
		</nav>

		<div class="mt-9 max-w-4xl rounded-[2rem] border border-primary/10 bg-bg-secondary/80 p-7 shadow-sm dark:bg-bg-secondary-dark md:mt-12 md:p-11">
			<div class="flex flex-wrap items-center gap-2 text-xs font-medium">
				<span class="inline-flex items-center gap-1.5 rounded-full bg-primary px-3 py-1.5 text-white">
					{data.pageKind === "landing" ? <BookOpen size={13} /> : <Sparkles size={13} />} {modeLabel}
				</span>
				<span class="inline-flex items-center gap-1.5 rounded-full border border-primary/10 px-3 py-1.5 text-neutral-500 dark:border-neutral-700 dark:text-neutral-400">
					<Clock3 size={13} /> {labels[data.audience]}
				</span>
			</div>
			<h1 class="font-brand mt-6 max-w-3xl text-5xl leading-[0.96] md:text-6xl">{data.title}</h1>
			<p class="mt-5 max-w-2xl text-lg leading-relaxed text-neutral-600 dark:text-neutral-300">{data.summary}</p>
			<p class="mt-7 text-xs text-neutral-500 dark:text-neutral-400">{labels.updated} {formattedUpdated}</p>
		</div>
	</section>

	<section class="site-container pb-16 pt-10 md:pb-24 md:pt-14">
		<div class:list={[
			"grid grid-cols-1 gap-10",
			data.pageKind === "article" && visibleHeadings.length > 1
				? "lg:grid-cols-[220px_minmax(0,720px)] lg:gap-16"
				: "max-w-3xl",
		]}>
			{data.pageKind === "article" && visibleHeadings.length > 1 && (
				<aside class="lg:sticky lg:top-28 lg:self-start">
					<p class="mb-3 text-xs font-semibold uppercase tracking-[0.16em] text-neutral-500 dark:text-neutral-400">{labels.inArticle}</p>
					<ol class="space-y-1 border-l border-primary/15 dark:border-neutral-700">
						{visibleHeadings.map((heading) => (
							<li>
								<a
									href={`#${heading.slug}`}
									class:list={[
										"block py-2 text-sm leading-snug text-neutral-500 transition-colors hover:text-primary dark:text-neutral-400",
										heading.depth === 3 ? "pl-7" : "pl-4",
									]}
								>
									{heading.text}
								</a>
							</li>
						))}
					</ol>
				</aside>
			)}

			<div class="min-w-0">
				<article class="article-content">
					<Content />
				</article>

				{related.length > 0 && (
					<section class="mt-14 border-t border-dashed border-primary/15 pt-10 dark:border-neutral-700">
						<div class="flex items-center gap-3">
							<FileText class="h-5 w-5 text-primary" />
							<h2 class="text-2xl font-semibold">{labels.related}</h2>
						</div>
						<div class="mt-5 grid gap-4 sm:grid-cols-2">
							{related.map((candidate) => (
								<a href={guidePath(lang, candidate.data.slug)} class="group rounded-2xl border border-primary/10 p-5 transition hover:border-primary/30 hover:shadow-md dark:border-neutral-700">
									<p class="text-xs font-semibold uppercase tracking-[0.12em] text-primary">{candidate.data.diataxis ? labels[candidate.data.diataxis] : labels.landing}</p>
									<h3 class="mt-2 font-semibold text-neutral-800 dark:text-neutral-100">{candidate.data.title}</h3>
									<p class="mt-2 text-sm leading-relaxed text-neutral-500 dark:text-neutral-400">{candidate.data.summary}</p>
									<span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-primary transition-all group-hover:gap-2.5">{labels.open} <ArrowRight size={15} /></span>
								</a>
							))}
						</div>
					</section>
				)}

				<section class="mt-12 rounded-3xl bg-primary px-7 py-8 text-white md:p-9">
					<h2 class="text-2xl font-semibold">{labels.helpTitle}</h2>
					<p class="mt-3 max-w-xl text-sm leading-relaxed text-white/80">{labels.helpBody}</p>
					<a href={contactPath} class="mt-6 inline-flex items-center gap-2 rounded-xl bg-white px-5 py-3 text-sm font-semibold text-primary transition hover:bg-neutral-100">
						{labels.helpAction} <ArrowRight size={16} />
					</a>
				</section>
			</div>
		</div>
	</section>
</Layout>
