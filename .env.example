# == Site ==========================================================
# Live domain (SCRUM-69). Used for canonical URLs, OG tags, sitemap.
PUBLIC_SITE_URL=https://getsort.app

# == Analytics =====================================================
# Plausible (primary) — set to the site's domain, e.g. getsort.app
PUBLIC_PLAUSIBLE_DOMAIN=
# Optional alternates (leave blank if using Plausible):
PUBLIC_GA4_ID=
PUBLIC_UMAMI_ID=

# == Lead form backend — Pages Function /api/lead (SCRUM-67 / SCRUM-63) ==
# Server-side only. Set these in Cloudflare Pages -> Settings -> Environment
# variables (NOT the PUBLIC_ prefix — they must never reach the browser).
# The Supabase project URL is public and fixed in functions/api/lead.ts; only the
# service-role key belongs in Pages secrets.
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
# Verified Resend sender (defaults to onboarding@resend.dev for first tests):
LEAD_FROM_EMAIL=
# Optional Telegram ping on each new lead:
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
